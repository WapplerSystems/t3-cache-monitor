{
    "name": "wapplersystems/cache-monitor",
    "type": "typo3-cms-extension",
    "description": "Cache monitoring dashboard, backend module and CLI command for TYPO3",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^14",
        "typo3/cms-backend": "^14",
        "typo3/cms-fluid": "^14"
    },
    "suggest": {
        "typo3/cms-dashboard": "For dashboard widget support"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\CacheMonitor\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "cache_monitor"
        }
    }
}
